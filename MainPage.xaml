<?xml version="1.0" encoding="utf-8" ?>
<!--
    Bug reproduction: Shell TitleView has unremovable margins on iOS.

    1. Left/right: ~16pt horizontal margins from UINavigationBar's directional layout margins.
       The TitleView content cannot extend to the screen edges.

    2. Top/bottom: the TitleView does not fill the full navigation bar height, leaving a visible
       gap between the TitleView content and the page body below.

    3. Setting Padding, Margin, HorizontalOptions, VerticalOptions on the TitleView content
       has no effect on these platform-level margins.

    The red TitleView background and blue page content make both issues clearly visible.
-->
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="TitleViewBug.MainPage"
  Padding="0"
  Shell.NavBarHasShadow="False"
>
  <Shell.TitleView>
    <Grid
      BackgroundColor="Red"
      Padding="0"
      Margin="0"
      ColumnSpacing="0"
      ColumnDefinitions="Auto,*,Auto"
    >
      <Label Text="☰" FontSize="24" TextColor="White" VerticalOptions="Center" Margin="10,0" />
      <Label
        Grid.Column="1"
        Text="MY APP TITLE"
        TextColor="White"
        FontSize="16"
        FontAttributes="Bold"
        HorizontalOptions="Center"
        VerticalOptions="Center"
      />
      <Label
        Grid.Column="2"
        Text="⚙"
        FontSize="24"
        TextColor="White"
        VerticalOptions="Center"
        Margin="10,0"
      />
    </Grid>
  </Shell.TitleView>

  <!-- Blue content to make the gap between TitleView and content clearly visible -->
  <BoxView Color="DodgerBlue" />
</ContentPage>
